# Example environment variables for local development
DATABASE_URL="postgresql://user:password@localhost:5432/fluidgym"
ANTHROPIC_API_KEY="your-anthropic-key"
YOUTUBE_API_KEY="your-youtube-key"
JWT_SECRET="replace-with-a-secure-secret"

# Google OAuth client ID (Google Cloud Console > APIs & Services > Credentials).
# Not a secret — this same value is read server-side (as the token audience) and
# client-side (VITE_-prefixed, so Vite exposes it to the browser bundle).
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
